# Configuration du serveur
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/tunip
DB_NAME=tunip

# JWT Secret (IMPORTANT: Changez cette valeur en production!)
JWT_SECRET=your_jwt_secret_key_change_me_to_something_secure

# API Appel Offres
API_BASE_URL=https://be.appeloffres.net/api
API_EMAIL=your_email@example.com
API_PASSWORD=your_password

# IDs par défaut pour l'API
DEFAULT_SOURCE_ID=1674
DEFAULT_SOURCE_ID_PNUD=1656
DEFAULT_PROMOTER_ID=223472
DEFAULT_AVIS_ID=1
DEFAULT_PAYS_ID=70
DEFAULT_CURRENCY_ID=111

# Collections MongoDB - BOAMP
BOAMP_COLLECTION_NAME=boampvalidates
BOAMP_PENDING_COLLECTION_NAME=boampoffres

# Collections MongoDB - PNUD
PNUD_COLLECTION_NAME=tenders_pnud
PNUD_PENDING_COLLECTION_NAME=pending_tenders_pnud

# Chemins (pour Windows - ajuster pour Linux/Mac)
POPPLER_PATH=C:\poppler\Library\bin
PDF_DIR=C:\Users\lenovo\extractionautomatic\backend\scripts\pdf_tuneps_extraction
IMAGES_DIR=images
OUTPUT_DIR=output

# Frontend
REACT_APP_API_BASE=http://localhost:5000/api
