    def load_pending_offers(self):
        """Charger les offres pending depuis DB"""
        try:
            pending_docs = list(pending_tenders_collection.find({
                "status": "pending",
                "source": "France Marchés"
            }).sort("createdAt", -1))
            
            self.offres_cache = []
            for doc in pending_docs:
                if doc.get('secteur_activite') == "informatique":
                    offre = OffreInformatique(**doc)
                elif doc.get('secteur_activite') == "textile":
                    offre = OffreTextile(**doc)
                elif doc.get('secteur_activite') == "batiment":
                    offre = OffreBatiment(**doc)
                else:
                    continue
                self.offres_cache.append(offre)
            
            self.logger.info(f"✅ {len(self.offres_cache)} offres pending chargées depuis DB (France Marchés)")
        except PyMongoError as e:
            self.logger.error(f"Erreur chargement pending: {e}")

    def _load_secteurs_from_json(self):
        secteurs = {}
        for secteur in SECTEURS_JSON["results"]:
            if secteur["isEnabled"]:
                secteurs[secteur["id"]] = {
                    "name": secteur["name"],
                    "activities": [{"id": act["id"], "name": act["name"].lower()} for act in secteur["activities"]]
                }
        self.secteurs_cache = secteurs
        self.logger.info(f"✅ {len(secteurs)} secteurs chargés")
        return secteurs

    def assigner_secteur_automatique(self, texte: str, categorie: str = None) -> Tuple[str, Optional[int], List[int]]:
        texte_lower = self.nettoyer_texte(texte)
        all_keywords = {}
        
        for secteur_id, secteur_data in self.secteurs.items():
            all_keywords[secteur_id] = {}
            for activity in secteur_data["activities"]:
                activity_words = re.findall(r'\b\w+\b', activity["name"])
                poids = 5.0
                
                if categorie:
                    if categorie == "informatique" and any(kw in activity["name"] for kw in self.keywords_informatique.keys()):
                        poids = 10.0
                    elif categorie == "textile" and any(kw in activity["name"] for kw in self.keywords_textile.keys()):
                        poids = 10.0
                    elif categorie == "batiment" and any(kw in activity["name"] for kw in self.keywords_batiment.keys()):
                        poids = 10.0
                
                for word in activity_words:
                    if len(word) > 3:
                        all_keywords[secteur_id][word] = poids / len(activity_words)

        best_secteur_id = None
        best_score = 0.0
        matching_activities = []

        for secteur_id, kws in all_keywords.items():
            secteur_score = 0.0
            for kw, poids in kws.items():
                if kw in texte_lower:
                    secteur_score += poids
            
            if secteur_score > best_score:
                best_score = secteur_score
                best_secteur_id = secteur_id
                sector_activities = self.secteurs[secteur_id]["activities"]
                matching_activities = []
                
                for activity in sector_activities:
                    activity_score = 0.0
                    activity_words = re.findall(r'\b\w+\b', activity["name"])
                    for word in activity_words:
                        if word in texte_lower:
                            activity_score += poids
                    if activity_score > 0:
                        matching_activities.append((activity["id"], activity["name"], activity_score))
                
                matching_activities.sort(key=lambda x: x[2], reverse=True)
                matching_activities = matching_activities[:5]

        if best_secteur_id:
            secteur_name = self.secteurs[best_secteur_id]["name"]
            activity_ids = [act[0] for act in matching_activities]
            return secteur_name, best_secteur_id, activity_ids

        return "Secteur non classé", None, []

    def __del__(self):
        if self.driver:
            try:
                self.driver.quit()
                self.logger.info("Driver Selenium fermé")
            except Exception:
                pass

    def generer_pdf_path(self, filename: str) -> str:
        return os.path.join(self.pdf_dir, filename).replace('\\', '/')

    def pdf_to_base64(self, pdf_path: str) -> str:
        try:
            if os.path.exists(pdf_path):
                with open(pdf_path, 'rb') as pdf_file:
                    return base64.b64encode(pdf_file.read()).decode('utf-8')
        except Exception as e:
            self.logger.error(f"Erreur conversion PDF en base64: {e}")
        return ""

    @tenacity.retry(stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_exponential(multiplier=1, min=4, max=10))
    def login_appeloffres(self) -> bool:
        if self.access_token:
            return True
        try:
            response = self.session_appeloffres.post(
                LOGIN_ENDPOINT,
                json={"email": EMAIL, "password": PASSWORD},
                headers=self.appeloffres_headers,
                timeout=30
            )
            if response.status_code in [200, 201]:
                data = response.json()
                self.access_token = data.get("accessToken")
                self.appeloffres_headers["Authorization"] = f"Bearer {self.access_token}"
                self.logger.info("✅ Connexion API réussie")
                return True
            self.logger.error(f"❌ ERREUR CONNEXION: Status {response.status_code}")
            return False
        except Exception as e:
            self.logger.error(f"❌ ERREUR CONNEXION: {e}")
            return False

    def get_or_create_promoter(self, promoter_name: str) -> str:
        if not promoter_name:
            return self.default_promoter_id
        
        clean_name = self.nettoyer_texte(promoter_name)
        if clean_name in self.promoter_cache:
            return self.promoter_cache[clean_name]
        
        if not self.login_appeloffres():
            return self.default_promoter_id
        
        payload = {
            "name": promoter_name,
            "description": f"Promoteur France Marchés: {promoter_name}",
            "reference": re.sub(r'\W+', '_', promoter_name.upper())[:20],
            "isEnabled": True,
            "companyName": promoter_name,
            "address": {
                "street": "1 Rue de la Paix",
                "city": "Paris",
                "country": "France",
                "postalCode": "75001"
            }
        }
        
        try:
            response = self.session_appeloffres.post(
                PROMOTER_ENDPOINT,
                json=payload,
                headers=self.appeloffres_headers,
                timeout=30
            )
            if response.status_code in [200, 201]:
                promoter_id = response.json().get("id")
                self.promoter_cache[clean_name] = str(promoter_id)
                return str(promoter_id)
            return self.default_promoter_id
        except Exception as e:
            self.logger.error(f"❌ Erreur promoteur: {e}")
            return self.default_promoter_id

    def map_offre_to_tender_payload(self, offre) -> dict:
        def parse_date(date_str):
            if not date_str or date_str == "N/A":
                return None
            try:
                dt = parse(date_str, fuzzy=True)
                return dt.isoformat() + "Z"
            except:
                return None
        
        publication_iso = parse_date(offre.publicationDate)
        expiration_iso = parse_date(offre.expirationDate)
        
        if publication_iso is None:
            publication_iso = datetime.now().isoformat() + "Z"
        if expiration_iso is None:
            expiration_iso = (datetime.now() + timedelta(days=30)).isoformat() + "Z"
        
        batches = []
        for lot in (offre.lots or []):
            batches.append({
                "activitiesIds": offre.activities_ids[:3] if offre.activities_ids else [],
                "title": lot.get("titre", "Lot sans titre"),
                "deposit": "0"
            })
        
        clean_content = self.nettoyer_texte(offre.full_content) or offre.description or "Contenu non disponible"
        title_value = clean_content[:1000] or "Offre sans titre"
        specifications_content = offre.url_source or "URL non disponible"
        promoter_id = self.get_or_create_promoter(offre.promoter)
        
        payload = {
            "title": title_value,
            "description": offre.description or "Description non disponible",
            "publicationDate": publication_iso,
            "startBiddingDate": publication_iso,
            "expirationDate": expiration_iso,
            "openingBidsDate": expiration_iso,
            "reference": offre.reference,
            "specificationsPrice": "0",
            "offerValidityPeriode": 30,
            "avisId": int(DEFAULT_AVIS_ID),
            "sourceId": int(offre.sourceId or self.default_source_id),
            "promoterId": int(promoter_id),
            "businessSectorId": offre.secteur_activite_id,
            "type": offre.type,
            "nature": offre.nature,
            "isEnabled": True,
            "images": [],
            "specificationsReceivingAddress": specifications_content,
            "fundingSourceType": "national",
            "fundingSource": offre.fundingSource or "national",
            "currencyId": 111,
            "isMultiCurrency": offre.isMultiCurrency,
            "batches": batches,
            "addresses": [{"countryId": DEFAULT_PAYS_ID, "regionId": "18"}]
        }
        
        if offre.cahier_charge_pdf_base64:
            payload["pdfBase64"] = offre.cahier_charge_pdf_base64
        
        self.logger.info(f"🔄 Transfert offre {offre.reference}: Secteur ID = {offre.secteur_activite_id} ({offre.secteur_activite})")
        
        return {k: v for k, v in payload.items() if v is not None}

    @tenacity.retry(stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_exponential(multiplier=1, min=4, max=10))
    def post_tender_to_database(self, offre) -> dict:
        """Insérer l'offre validée dans MongoDB et supprimer de pending"""
        if offre.secteur_activite_id is None:
            self.logger.error(f"❌ Insertion impossible: Secteur non défini pour {offre.reference}")
            return {"success": False, "message": "Secteur non défini", "offre_ref": offre.reference}

        existing = tenders_collection.find_one({"reference": offre.reference})
        if existing:
            self.logger.info(f"⚠️ Offre {offre.reference} existe déjà en base validée")
            return {"success": False, "message": "Offre déjà validée", "offre_ref": offre.reference}

        tender_dict = offre.to_dict()
        tender_dict["status"] = "active"
        tender_dict["validationDate"] = datetime.now().isoformat()

        try:
            result = tenders_collection.insert_one(tender_dict)
            if result.inserted_id:
                pending_tenders_collection.delete_one({"reference": offre.reference})
                self.logger.info(f"✅ Insertion réussie: {offre.reference} - Secteur: {offre.secteur_activite} (ID: {offre.secteur_activite_id})")
                
                # Poster vers l'API après insertion DB
                try:
                    if not self.login_appeloffres():
                        self.logger.error(f"❌ Échec connexion API pour {offre.reference}")
                    else:
                        payload = self.map_offre_to_tender_payload(offre)
                        response = self.session_appeloffres.post(
                            TENDER_ENDPOINT,
                            json=payload,
                            headers=self.appeloffres_headers,
                            timeout=30
                        )
                        if response.status_code in [200, 201]:
                            api_data = response.json()
                            api_id = api_data.get("id")
                            self.logger.info(f"✅ Envoi API réussi: {offre.reference} - ID API: {api_id}")
                            tenders_collection.update_one(
                                {"_id": result.inserted_id},
                                {"$set": {"api_id": api_id}}
                            )
                        else:
                            self.logger.error(f"❌ Envoi API échoué: {response.status_code} - {response.text}")
                except Exception as api_e:
                    self.logger.error(f"❌ Erreur envoi API: {api_e}")
                
                return {
                    "success": True,
                    "message": f"Insertion réussie - Secteur: {offre.secteur_activite} (ID: {offre.secteur_activite_id})",
                    "offre_ref": offre.reference,
                    "mongo_id": str(result.inserted_id)
                }
            else:
                raise PyMongoError("Insertion échouée sans ID")
        except PyMongoError as e:
            self.logger.error(f"❌ Erreur MongoDB: {e}")
            return {"success": False, "message": f"Erreur MongoDB: {str(e)}", "offre_ref": offre.reference}
        except Exception as e:
            self.logger.error(f"❌ Erreur insertion: {e}")
            return {"success": False, "message": f"Erreur: {str(e)}", "offre_ref": offre.reference}

    def save_to_pending(self, offre):
        """Sauvegarder une offre en pending dans DB"""
        try:
            tender_dict = offre.to_dict()
            tender_dict["status"] = "pending"
            result = pending_tenders_collection.insert_one(tender_dict)
            if result.inserted_id:
                self.logger.info(f"✅ Offre sauvegardée en pending: {offre.reference}")
                return True
            return False
        except Exception as e:
            self.logger.error(f"Erreur save pending: {e}")
            return False

    def nettoyer_texte(self, texte: str) -> str:
        if not texte:
            return ""
        texte = unicodedata.normalize('NFKD', str(texte))
        texte = ''.join(c for c in texte if not unicodedata.combining(c))
        texte = re.sub(r'\{\{.*?\}\}', '', texte)
        texte = re.sub(r'\s+', ' ', texte)
        texte = re.sub(r'[^\x20-\x7E]', ' ', texte)
        return texte.strip().lower()

    def normaliser_date(self, date_text: str) -> str:
        if not date_text or date_text in ["N/A", "None", "null"]:
            return "N/A"
        try:
            parsed_date = parse(date_text, fuzzy=True)
            return f"{parsed_date.strftime('%d/%m/%Y')} à {parsed_date.strftime('%Hh%M')}"
        except:
            return "N/A"

    @tenacity.retry(stop=tenacity.stop_after_attempt(3), wait=tenacity.wait_exponential(multiplier=1, min=4, max=10))
    def _get_soup_from_url(self, url: str) -> Optional[BeautifulSoup]:
        try:
            if self.use_selenium and self.driver:
                self.driver.get(url)
                WebDriverWait(self.driver, 10).until(
                    lambda d: d.execute_script("return document.readyState") == "complete"
                )
                time.sleep(2)  # Attendre le chargement dynamique
                return BeautifulSoup(self.driver.page_source, 'html.parser')
            else:
                response = self.session.get(url, timeout=30, allow_redirects=True)
                if response.status_code != 200:
                    return None
                return BeautifulSoup(response.content, 'html.parser')
        except Exception as e:
            self.logger.error(f"ERREUR SOUP: {e}")
            return None

    def extraire_date_limite(self, soup: BeautifulSoup) -> str:
        """Extraire la date limite de réception des offres"""
        try:
            # Patterns France Marchés
            date_patterns = [
                r'Date\s*limite\s*de\s*r[eé]ception\s*des\s*offres\s*[:]*\s*(\d{1,2}[/-]\d{1,2}[/-]\d{4}(?:\s+\d{1,2}[h:]\d{2})?)',
                r'Date\s*et\s*heure\s*limites\s*de\s*r[eé]ception\s*[:]*\s*(\d{1,2}[/-]\d{1,2}[/-]\d{4}(?:\s+\d{1,2}[h:]\d{2})?)',
                r'Date\s*de\s*cl[ôo]ture\s*[:]*\s*(\d{1,2}[/-]\d{1,2}[/-]\d{4}(?:\s+\d{1,2}[h:]\d{2})?)',
            ]
            
            page_text = soup.get_text(separator=' ', strip=True)
            
            for pattern in date_patterns:
                match = re.search(pattern, page_text, re.IGNORECASE)
                if match:
                    date_value = match.group(1)
                    normalized = self.normaliser_date(date_value)
                    if normalized != "N/A":
                        self.logger.info(f"✅ Date limite trouvée: {normalized}")
                        return normalized
            
            # Chercher dans les divs spécifiques
            date_div = soup.find('div', class_=re.compile(r'date.*limite|deadline', re.I))
            if date_div:
                date_text = date_div.get_text(strip=True)
                normalized = self.normaliser_date(date_text)
                if normalized != "N/A":
                    return normalized
            
            return "N/A"
        except Exception as e:
            self.logger.error(f"ERREUR DATE: {e}")
            return "N/A"

    def extraire_procedure(self, soup: BeautifulSoup) -> str:
        """Extraire la procédure"""
        try:
            page_text = soup.get_text(separator=' ', strip=True)
            match = re.search(r'Proc[eé]dure\s*[:]*\s*([^\n\r]+?)(?:\s{2,}|$)', page_text, re.IGNORECASE)
            if match:
                procedure = match.group(1).strip().capitalize()
                self.logger.info(f"✅ Procédure trouvée: {procedure}")
                return procedure
            
            # Chercher dans les éléments spécifiques
            proc_elem = soup.find(text=re.compile(r'proc[eé]dure', re.I))
            if proc_elem:
                parent = proc_elem.find_parent()
                if parent:
                    return parent.get_text(strip=True).split(':')[-1].strip()
            
            return "N/A"
        except Exception as e:
            self.logger.error(f"ERREUR PROCEDURE: {e}")
            return "N/A"

    def extraire_type_marche(self, soup: BeautifulSoup) -> str:
        """Extraire le type de marché"""
        try:
            page_text = soup.get_text(separator=' ', strip=True)
            match = re.search(r'Type\s*de\s*march[eé]\s*[:]*\s*([^\n\r]+?)(?:\s{2,}|$)', page_text, re.IGNORECASE)
            if match:
                type_marche = match.group(1).strip().capitalize()
                self.logger.info(f"✅ Type de marché trouvé: {type_marche}")
                return type_marche
            return "Public"
        except Exception as e:
            self.logger.error(f"ERREUR TYPE MARCHE: {e}")
            return "Public"

    def extraire_lots(self, soup: BeautifulSoup) -> Tuple[List[Dict], str]:
        """Extraire les lots depuis la page"""
        lots = []
        try:
            page_text = soup.get_text(separator='\n', strip=True)
            
            patterns = [
                r'(?:Lot|LOT)\s*(?:n°|N°|numero|numéro)?\s*(\d+)\s*[:–-]?\s*([^\n]+?)(?=(?:Lot|LOT)\s*(?:n°|N°|numero|numéro)?\s*\d+|$)',
                r'(?:Lot|LOT)\s*(\d+)\s*[:–-]\s*(.+?)(?=(?:Lot|LOT)\s*\d+|$)',
            ]
            
            for pattern in patterns:
                matches = re.finditer(pattern, page_text, re.IGNORECASE | re.DOTALL)
                for match in matches:
                    numero = match.group(1).strip()
                    titre = match.group(2).strip()[:300]
                    titre = re.sub(r'\s+', ' ', titre)
                    titre = titre.split('\n')[0]
                    
                    if len(titre) > 10:
                        lot = {
                            'numero': numero,
                            'titre': titre,
                            'description': titre
                        }
                        lots.append(lot)
                        self.logger.info(f"✅ Lot trouvé: Lot {numero} - {titre[:50]}...")
            
            # Dédupliquer
            seen = set()
            unique_lots = []
            for lot in lots:
                key = (lot['numero'], lot['titre'][:50])
                if key not in seen:
                    seen.add(key)
                    unique_lots.append(lot)
            
            lots_summary = "; ".join([f"Lot {lot['numero']}: {lot['titre'][:50]}" for lot in unique_lots])
            return unique_lots, lots_summary if unique_lots else "Aucun lot détecté"
            
        except Exception as e:
            self.logger.error(f"ERREUR LOTS: {e}")
            return lots, f"ERREUR: {str(e)}"

    def generate_pdf_reportlab(self, id_offre, fields, contenu, lots, pdf_path):
        """Générer un PDF avec ReportLab"""
        try:
            pdf_path = pdf_path.replace('\\', '/')
            os.makedirs(os.path.dirname(pdf_path), exist_ok=True)
            
            doc = SimpleDocTemplate(
                pdf_path,
                pagesize=A4,
                rightMargin=1.5*cm,
                leftMargin=1.5*cm,
                topMargin=1.5*cm,
                bottomMargin=1.5*cm
            )
            story = []
            styles = getSampleStyleSheet()
            
            title_style = ParagraphStyle(
                'Title',
                parent=styles['Title'],
                fontSize=18,
                spaceAfter=25,
                textColor=HexColor('#1a365d'),
                alignment=TA_CENTER
            )
            header_style = ParagraphStyle(
                'Header',
                parent=styles['Heading2'],
                fontSize=14,
                spaceAfter=12,
                textColor=HexColor('#2d3748')
            )
            body_style = ParagraphStyle(
                'Body',
                parent=styles['Normal'],
                fontSize=10,
                spaceAfter=8,
                textColor=black,
                alignment=TA_JUSTIFY
            )
            
            story.append(Paragraph(f"CAHIER DES CHARGES - {id_offre}", title_style))
            story.append(Spacer(1, 0.5*cm))
            story.append(Paragraph("📋 Informations principales", header_style))
            
            info_data = [
                [Paragraph('<b>RÉFÉRENCE</b>', body_style), Paragraph(f"<b>{id_offre}</b>", body_style)],
                [Paragraph('<b>ACHETEUR</b>', body_style), Paragraph(f"<b>{fields.get('acheteur', 'N/A')}</b>", body_style)],
                [Paragraph('<b>DATE PUBLICATION</b>', body_style), Paragraph(f"<b>{fields.get('date_publication', 'N/A')}</b>", body_style)],
                [Paragraph('<b>DATE LIMITE</b>', body_style), Paragraph(f"<b>{contenu.get('expiration_date', 'N/A')}</b>", body_style)],
                [Paragraph('<b>PROCÉDURE</b>', body_style), Paragraph(f"<b>{contenu.get('procedure', 'N/A')}</b>", body_style)],
                [Paragraph('<b>TYPE MARCHÉ</b>', body_style), Paragraph(f"<b>{contenu.get('type_marche', 'Public')}</b>", body_style)]
            ]
            
            info_table = Table(info_data, colWidths=[5*cm, 10*cm])
            info_table.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (0, -1), HexColor('#2c5282')),
                ('TEXTCOLOR', (0, 0), (0, -1), white),
                ('GRID', (0, 0), (-1, -1), 1, HexColor('#e2e8f0')),
                ('PADDING', (0, 0), (-1, -1), 10)
            ]))
            story.append(info_table)
            story.append(Spacer(1, 0.8*cm))
            
            story.append(Paragraph("📝 Description", header_style))
            desc_text = contenu.get('description_complete', '')[:2000]
            story.append(Paragraph(desc_text, body_style))
            story.append(Spacer(1, 0.5*cm))
            
            if lots:
                story.append(Paragraph(f"📑 Lots ({len(lots)})", header_style))
                for lot in lots:
                    story.append(Paragraph(f"<b>Lot {lot['numero']}</b>: {lot['titre']}", body_style))
                    story.append(Spacer(1, 0.3*cm))
            
            doc.build(story)
            
            if os.path.exists(pdf_path) and os.path.getsize(pdf_path) > 100:
                self.logger.info(f"✅ PDF généré: {pdf_path}")
                return True
            else:
                self.logger.error(f"❌ PDF corrompu: {pdf_path}")
                return False
        except Exception as e:
            self.logger.error(f"❌ Erreur PDF: {e}\n{traceback.format_exc()}")
            return False

    def extraire_contenu_detaille(self, url: str, fields: dict, id_offre: str) -> dict:
        """Extraire le contenu détaillé d'une offre"""
        contenu = {
            'reference': id_offre,
            'description_complete': self.nettoyer_texte(fields.get('titre', '')),
            'expiration_date': 'N/A',
            'pieces_jointes': [],
            'lots': [],
            'texte_integral': '',
            'pdf_path': '',
            'pdf_filename': '',
            'procedure': 'N/A',
            'type_marche': 'Public'
        }
        
        try:
            soup = self._get_soup_from_url(url)
            if soup:
                contenu['expiration_date'] = self.extraire_date_limite(soup)
                contenu['procedure'] = self.extraire_procedure(soup)
                contenu['type_marche'] = self.extraire_type_marche(soup)
                
                # Extraire le contenu principal
                main_content = soup.select_one('div.content-main, article, div.detail-avis, main')
                contenu['texte_integral'] = main_content.get_text(separator=' ', strip=True) if main_content else soup.get_text(separator=' ', strip=True)
                
                # Extraire les pièces jointes
                for link in soup.find_all('a', href=True):
                    if any(ext in link['href'].lower() for ext in ['.pdf', '.doc', '.docx', '.zip']):
                        contenu['pieces_jointes'].append(urljoin(url, link['href']))
                
                # Extraire les lots
                contenu['lots'], lots_summary = self.extraire_lots(soup)
                self.logger.info(f"Lots extraits: {lots_summary}")
                
                # Générer le PDF
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                pdf_filename = f"FM_{id_offre}_{timestamp}.pdf"
                pdf_path = self.generer_pdf_path(pdf_filename)
                
                if self.generate_pdf_reportlab(id_offre, fields, contenu, contenu['lots'], pdf_path):
                    contenu['pdf_path'] = pdf_path
                    contenu['pdf_filename'] = pdf_filename
            
            self.logger.info(f"✅ Extraction complète pour {id_offre}: Date={contenu['expiration_date']}, Lots={len(contenu['lots'])}")
        except Exception as e:
            self.logger.error(f"ERREUR EXTRACTION: {e}\n{traceback.format_exc()}")
        
        return contenu

    def analyser_pertinence_informatique(self, titre: str, texte: str) -> Tuple[float, List[str]]:
        texte_analyse = f"{titre} {texte}".lower()
        score = 0.0
        mots_detectes = []
        
        for mot_cle, poids in self.keywords_informatique.items():
            if re.search(r'\b' + re.escape(mot_cle.lower()) + r'\b', texte_analyse):
                score += poids
                mots_detectes.append(mot_cle)
        
        return score, list(set(mots_detectes))

    def analyser_pertinence_textile(self, titre: str, texte: str) -> Tuple[float, List[str]]:
        texte_analyse = f"{titre} {texte}".lower()
        score = 0.0
        mots_detectes = []
        
        for mot_cle, poids in self.keywords_textile.items():
            if re.search(r'\b' + re.escape(mot_cle.lower()) + r'\b', texte_analyse):
                score += poids
                mots_detectes.append(mot_cle)
        
        return score, list(set(mots_detectes))

    def analyser_pertinence_batiment(self, titre: str, texte: str) -> Tuple[float, List[str]]:
        texte_analyse = f"{titre} {texte}".lower()
        score = 0.0
        mots_detectes = []
        
        for mot_cle, poids in self.keywords_batiment.items():
            if re.search(r'\b' + re.escape(mot_cle.lower()) + r'\b', texte_analyse):
                score += poids
                mots_detectes.append(mot_cle)
        
        return score, list(set(mots_detectes))

    def est_offre_informatique(self, score: float, mots_cles: list) -> bool:
        return score >= 10.0 or (score >= 5.0 and len(set(mots_cles)) >= 1)

    def est_offre_textile(self, score: float, mots_cles: list) -> bool:
        return score >= 8.0 or (score >= 4.0 and len(set(mots_cles)) >= 1)

    def est_offre_batiment(self, score: float, mots_cles: list) -> bool:
        return score >= 10.0 or (score >= 5.0 and len(set(mots_cles)) >= 1)

    def traiter_offre_informatique(self, fields: dict, extraction_complete: bool = True) -> Optional[OffreInformatique]:
        id_offre = fields.get("reference")
        if not id_offre:
            return None
        
        titre = fields.get("titre", "")
        url = fields.get("url", "")
        
        contenu = {
            'lots': [],
            'pieces_jointes': [],
            'expiration_date': 'N/A',
            'pdf_path': '',
            'pdf_filename': '',
            'procedure': 'N/A',
            'type_marche': 'Public'
        }
        full_content = ""
        
        if extraction_complete and url:
            contenu = self.extraire_contenu_detaille(url, fields, id_offre)
            texte_analyse = f"{titre} {contenu.get('texte_integral', '')}"
            expiration_date = contenu.get('expiration_date', 'N/A')
            full_content = contenu.get('texte_integral', '')
        else:
            texte_analyse = titre
            expiration_date = fields.get('date_limite', 'N/A')
        
        score, mots_cles = self.analyser_pertinence_informatique(titre, texte_analyse)
        if not self.est_offre_informatique(score, mots_cles):
            return None
        
        secteur_name, secteur_id, activity_ids = self.assigner_secteur_automatique(
            f"{titre} {full_content}",
            "informatique"
        )
        
        pdf_base64 = ""
        if contenu.get('pdf_path'):
            pdf_base64 = self.pdf_to_base64(contenu['pdf_path'])
        
        offre = OffreInformatique(
            reference=id_offre,
            description=self.nettoyer_texte(titre),
            full_content=full_content,
            promoter=self.nettoyer_texte(fields.get("acheteur", "")),
            publicationDate=fields.get("date_publication", "N/A"),
            expirationDate=expiration_date,
            pieces_jointes=contenu.get('pieces_jointes', []),
            cahier_charge=contenu.get('pdf_path', ''),
            cahier_charge_pdf=contenu.get('pdf_path', ''),
            cahier_charge_pdf_filename=contenu.get('pdf_filename', ''),
            cahier_charge_pdf_base64=pdf_base64,
            lots=contenu.get('lots', []),
            mots_cles_detectes=mots_cles,
            sourceId=self.default_source_id,
            promoterId=None,
            fundingSource="national",
            secteur_activite=secteur_name,
            secteur_activite_id=secteur_id,
            activities_ids=activity_ids,
            procedure=contenu.get('procedure', 'N/A'),
            type_marche=contenu.get('type_marche', 'Public'),
            url_source=url,
            source="France Marchés"
        )
        
        self.offres_cache.append(offre)
        self.save_to_pending(offre)
        self.logger.info(f"✅ Offre IT ajoutée: {id_offre} - Secteur: {secteur_name}")
        return offre

