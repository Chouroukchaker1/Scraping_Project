app = Flask(__name__, 
           static_folder=REACT_BUILD_DIR, 
           static_url_path='', 
           template_folder=REACT_BUILD_DIR)

# Ajout CORS pour autoriser localhost:3000
CORS(app, resources={r"/api/*": {"origins": "http://localhost:3000"}})

scraper = FranceMarchesScraperInformatiqueTextileBatiment(use_selenium=True)

# Servir le build React
@app.route('/', defaults={'path': ''})
@app.route('/<path:path>')
def serve_react(path):
    if path != "" and os.path.exists(os.path.join(REACT_BUILD_DIR, path)):
        return send_file(os.path.join(REACT_BUILD_DIR, path))
    else:
        return send_file(os.path.join(REACT_BUILD_DIR, 'index.html'))

# API endpoints
@app.route('/api/secteurs')
def api_secteurs():
    """Récupérer la liste des secteurs"""
    return jsonify(scraper.get_secteurs_for_frontend())

@app.route('/api/scrape', methods=['POST'])
def scrape():
    """Lancer un scraping"""
    data = request.json
    # Fix: Utiliser des dates avec des résultats connus pour test (ajustez selon besoin)
    date_debut = data.get('date_debut', (datetime.now(timezone.utc) - timedelta(days=30)).strftime("%Y-%m-%d"))
    date_fin = data.get('date_fin', datetime.now(timezone.utc).strftime("%Y-%m-%d"))
    categories = data.get('categories', ["informatique", "textile", "batiment"])
    
    logger.info(f"Received scrape request: {data}")  # Log ajouté
    
    offres = scraper.scraper_offres_france_marches(
        date_debut, 
        date_fin, 
        extraction_complete=True, 
        categories=categories
    )
    
    return jsonify({
        "success": True,
        "message": f"{len(offres)} offres extraites",
        "offres": scraper.get_offres_cache()
    })

@app.route('/api/validate/<reference>', methods=['POST'])
def validate_offre(reference):
    """Valider une offre et l'insérer en DB"""
    # Vérifier si déjà validée
    existing_active = tenders_collection.find_one({
        "reference": reference,
        "status": "active",
        "source": "France Marchés"
    })
    if existing_active:
        return jsonify({
            "success": False,
            "message": "Offre déjà validée",
            "offre_ref": reference
        })
    
    # Chercher dans le cache
    for offre in scraper.offres_cache[:]:
        if offre.reference == reference:
            result = scraper.post_tender_to_database(offre)
            if result['success']:
                scraper.offres_cache.remove(offre)
            return jsonify(result)
    
    # Chercher en DB pending
    pending_doc = pending_tenders_collection.find_one({
        "reference": reference,
        "status": "pending",
        "source": "France Marchés"
    })
    if pending_doc:
        if pending_doc.get('secteur_activite') == "informatique":
            offre = OffreInformatique(**pending_doc)
        elif pending_doc.get('secteur_activite') == "textile":
            offre = OffreTextile(**pending_doc)
        elif pending_doc.get('secteur_activite') == "batiment":
            offre = OffreBatiment(**pending_doc)
        else:
            return jsonify({
                "success": False,
                "message": "Secteur inconnu",
                "offre_ref": reference
            })
        
        result = scraper.post_tender_to_database(offre)
        if result['success']:
            scraper.offres_cache = [o for o in scraper.offres_cache if o.reference != reference]
            pending_tenders_collection.delete_one({
                "reference": reference,
                "source": "France Marchés"
            })
        return jsonify(result)
    
    return jsonify({
        "success": False,
        "message": "Offre non trouvée",
        "offre_ref": reference
    })

@app.route('/api/update/<reference>', methods=['POST'])
def update_offre(reference):
    """Mettre à jour une offre"""
    data = request.json
    if scraper.update_offre_in_cache(reference, data):
        return jsonify({
            "success": True,
            "message": "Offre mise à jour",
            "offre_ref": reference
        })
    return jsonify({
        "success": False,
        "message": "Offre non trouvée",
        "offre_ref": reference
    })

@app.route('/api/tenders', methods=['GET'])
def get_tenders():
    """Récupérer les tenders validés"""
    tenders = scraper.get_tenders_from_db()
    return jsonify({
        "success": True,
        "tenders": tenders
    })

@app.route('/api/pending', methods=['GET'])
def get_pending():
    """Récupérer les tenders non validés"""
    return jsonify({
        "success": True,
        "pending": scraper.get_offres_cache()
    })

@app.route('/api/download_pdf/<filename>')
def download_pdf(filename):
    """Télécharger un PDF"""
    pdf_path = os.path.join(PDF_DIR, filename)
    if os.path.exists(pdf_path):
        return send_file(pdf_path, as_attachment=True)
    return jsonify({
        "success": False,
        "message": "PDF non trouvé"
    }), 404

@app.route('/api/stats', methods=['GET'])
def get_stats():
    """Récupérer les statistiques"""
    try:
        total_validated = tenders_collection.count_documents({
            "status": "active",
            "source": "France Marchés"
        })
        total_pending = pending_tenders_collection.count_documents({
            "status": "pending",
            "source": "France Marchés"
        })
        
        stats_by_secteur = {}
        for secteur_id, secteur_data in scraper.secteurs.items():
            count = tenders_collection.count_documents({
                "status": "active",
                "source": "France Marchés",
                "secteur_activite_id": secteur_id
            })
            if count > 0:
                stats_by_secteur[secteur_data["name"]] = count
        
        return jsonify({
            "success": True,
            "stats": {
                "total_validated": total_validated,
                "total_pending": total_pending,
                "by_secteur": stats_by_secteur,
                "source": "France Marchés"
            }
        })
    except Exception as e:
        logger.error(f"Erreur stats: {e}")
        return jsonify({
            "success": False,
            "message": str(e)
        }), 500

@app.route('/api/delete_pending/<reference>', methods=['DELETE'])
def delete_pending(reference):
    """Supprimer une offre pending"""
    try:
        result = pending_tenders_collection.delete_one({
            "reference": reference,
            "source": "France Marchés"
        })
        if result.deleted_count > 0:
            # Supprimer du cache aussi
            scraper.offres_cache = [o for o in scraper.offres_cache if o.reference != reference]
            return jsonify({
                "success": True,
                "message": "Offre supprimée"
            })
        return jsonify({
            "success": False,
            "message": "Offre non trouvée"
        }), 404
    except Exception as e:
        logger.error(f"Erreur suppression: {e}")
        return jsonify({
            "success": False,
            "message": str(e)
        }), 500

@app.route('/api/health', methods=['GET'])
def health_check():
    """Vérifier l'état du service"""
    try:
        mongo_status = "connected" if mongo_client.server_info() else "disconnected"
    except:
        mongo_status = "disconnected"
    
    return jsonify({
        "success": True,
        "status": "running",
        "source": "France Marchés",
        "selenium": scraper.use_selenium,
        "mongodb": mongo_status,
        "pending_count": len(scraper.offres_cache)
    })

