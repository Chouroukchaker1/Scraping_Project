if __name__ == "__main__":
    if len(sys.argv) > 1:
        try:
            raw_arg = sys.argv[1]
            # Utiliser manual_unquote au lieu de shlex.unquote pour robustesse
            arg = manual_unquote(raw_arg)
            # Nettoyer les espaces
            arg = arg.strip()
            data = json.loads(arg)
            date_debut = data.get('date_debut', '2025-09-01')  # Dates avec résultats pour test
            date_fin = data.get('date_fin', '2025-10-12')
            categories = data.get('categories', ['informatique', 'textile', 'batiment'])
            
            print(f"🚀 Lancement scrape manuel: {date_debut} à {date_fin}, cats: {categories}")
            print(f"📄 Argument parsé: {arg}")  # Debug: afficher l'argument parsé
            offres = scraper.scraper_offres_france_marches(
                date_debut, date_fin, extraction_complete=True, categories=categories
            )
            
            # Print résultats pour terminal
            print(json.dumps({
                "success": True,
                "message": f"{len(offres)} offres extraites",
                "offres": scraper.get_offres_cache()
            }, indent=2, ensure_ascii=False))
            
            # Sauvegarde en DB auto
            for offre in offres:
                scraper.save_to_pending(offre)
            
            sys.exit(0)
        except json.JSONDecodeError as e:
            print(f"❌ Erreur JSON: {e}")
            print(f"📄 Argument reçu: '{sys.argv[1] if len(sys.argv) > 1 else 'Aucun'}'")
            print("💡 Astuce: Utilisez des guillemets simples en PowerShell: py script.py '{\"date_debut\":\"2025-09-01\", \"date_fin\":\"2025-10-12\", \"categories\":[\"informatique\"]}'")
            print("   Ou doubles avec échappement: py script.py \"{\\\"date_debut\\\":\\\"2025-09-01\\\", \\\"date_fin\\\":\\\"2025-10-12\\\", \\\"categories\\\":[\\\"informatique\\\"]}\"")
            sys.exit(1)
        except Exception as e:
            print(f"❌ Erreur scrape: {e}")
            sys.exit(1)
    # Mode serveur Flask
    else:
        print("🚀 Lancement du serveur Flask pour France Marchés...")
        print("📁 Servir React depuis:", os.path.join(os.getcwd(), REACT_BUILD_DIR))
