# Fix pour shlex.unquote (fallback manuel si non disponible)
def manual_unquote(s: str) -> str:
    """Implémentation manuelle de shlex.unquote pour compatibilité."""
    if not s:
        return s
    # Enlever les guillemets simples ou doubles extérieurs si présents
    if (s.startswith('"') and s.endswith('"')) or (s.startswith("'") and s.endswith("'")):
        return s[1:-1]
    return s

