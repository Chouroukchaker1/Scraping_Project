            lots=contenu.get('lots', []),
            mots_cles_detectes=mots_cles,
            sourceId=self.default_source_id,
            promoterId=None,
            fundingSource="national",
            secteur_activite=secteur_name,
            secteur_activite_id=secteur_id,
            activities_ids=activity_ids,
            procedure=contenu.get('procedure', 'N/A'),
            type_marche=contenu.get('type_marche', 'Public'),
            url_source=url,
            source="France Marchés"
        )
        
        self.offres_cache.append(offre)
        self.save_to_pending(offre)
        self.logger.info(f"✅ Offre Textile ajoutée: {id_offre} - Secteur: {secteur_name}")
        return offre

    def traiter_offre_batiment(self, fields: dict, extraction_complete: bool = True) -> Optional[OffreBatiment]:
        id_offre = fields.get("reference")
        if not id_offre:
            return None
        
        titre = fields.get("titre", "")
        url = fields.get("url", "")
        
        contenu = {
            'lots': [],
            'pieces_jointes': [],
            'expiration_date': 'N/A',
            'pdf_path': '',
            'pdf_filename': '',
            'procedure': 'N/A',
            'type_marche': 'Public'
        }
        full_content = ""
        
        if extraction_complete and url:
            contenu = self.extraire_contenu_detaille(url, fields, id_offre)
            texte_analyse = f"{titre} {contenu.get('texte_integral', '')}"
            expiration_date = contenu.get('expiration_date', 'N/A')
            full_content = contenu.get('texte_integral', '')
        else:
            texte_analyse = titre
            expiration_date = fields.get('date_limite', 'N/A')
        
        score, mots_cles = self.analyser_pertinence_batiment(titre, texte_analyse)
        if not self.est_offre_batiment(score, mots_cles):
            return None
        
        secteur_name, secteur_id, activity_ids = self.assigner_secteur_automatique(
            f"{titre} {full_content}",
            "batiment"
        )
        
        pdf_base64 = ""
        if contenu.get('pdf_path'):
            pdf_base64 = self.pdf_to_base64(contenu['pdf_path'])
        
        offre = OffreBatiment(
            reference=id_offre,
            description=self.nettoyer_texte(titre),
            full_content=full_content,
            promoter=self.nettoyer_texte(fields.get("acheteur", "")),
            publicationDate=fields.get("date_publication", "N/A"),
            expirationDate=expiration_date,
            pieces_jointes=contenu.get('pieces_jointes', []),
            cahier_charge=contenu.get('pdf_path', ''),
            cahier_charge_pdf=contenu.get('pdf_path', ''),
            cahier_charge_pdf_filename=contenu.get('pdf_filename', ''),
            cahier_charge_pdf_base64=pdf_base64,
            lots=contenu.get('lots', []),
            mots_cles_detectes=mots_cles,
            sourceId=self.default_source_id,
            promoterId=None,
            fundingSource="national",
            secteur_activite=secteur_name,
            secteur_activite_id=secteur_id,
            activities_ids=activity_ids,
            procedure=contenu.get('procedure', 'N/A'),
            type_marche=contenu.get('type_marche', 'Public'),
            url_source=url,
            source="France Marchés"
        )
        
        self.offres_cache.append(offre)
        self.save_to_pending(offre)
        self.logger.info(f"✅ Offre Bâtiment ajoutée: {id_offre} - Secteur: {secteur_name}")
        return offre

    def scraper_offres_france_marches(self, date_debut: str, date_fin: str, 
                                      extraction_complete: bool = True, 
                                      categories: list = ["informatique", "textile", "batiment"]) -> List:
        """Scraper les offres de France Marchés"""
        self.logger.info(f"🔍 Recherche France Marchés: {date_debut} à {date_fin}, Catégories: {categories}")
        offres = []
        ids_vus = set()
        
        try:
            # Utiliser requests au lieu de Selenium pour la liste des résultats (serveur-side rendered)
            keywords = ' OR '.join(categories)  # ex: "informatique OR textile OR batiment"
            params = {
                'q': keywords,
                'date_parution_debut': date_debut,
                'date_parution_fin': date_fin
            }
            search_params = urlencode(params)
            search_url = f"{self.search_url}{search_params}"
            
            self.logger.info(f"🔗 URL de recherche: {search_url}")
            
            response = self.session.get(search_url, timeout=30)
            if response.status_code != 200:
                self.logger.error(f"❌ Erreur HTTP {response.status_code} pour {search_url}")
                return offres
            
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # Fix sélecteurs: liens vers /appel-offre/
            annonces = soup.find_all('a', href=re.compile(r'^/appel-offre/'))
            
            if not annonces:
                self.logger.warning("⚠️ Aucune annonce trouvée - vérifiez l'URL/params")
                # Log du titre de la page pour debug
                title = soup.find('title').get_text() if soup.find('title') else "No title"
                self.logger.warning(f"Titre page: {title}")
            
            self.logger.info(f"📊 {len(annonces)} annonces trouvées")
            
            for link in annonces:
                try:
                    # Extraire les informations de base
                    fields = {}
                    
                    # Texte de l'annonce (ex: "[001] TITRE - Acheteur - Description")
                    text = link.get_text(strip=True)
                    
                    # Référence (ex: [001])
                    if '[00' in text:
                        parts = text.split(']', 1)
                        fields['reference'] = parts[0].replace('[', '').strip() if parts else "FM_UNKNOWN"
                    else:
                        # Amélioration: chercher un pattern comme [XXX] au début
                        match_ref = re.match(r'\[(\d+)\]', text)
                        if match_ref:
                            fields['reference'] = match_ref.group(1)
                        else:
                            fields['reference'] = f"FM_{hash(text) % 10000}"  # Fallback hash
                    
                    if fields['reference'] in ids_vus:
                        continue
                    ids_vus.add(fields['reference'])
                    
                    # Titre (première partie après ref)
                    if ']' in text:
                        titre_part = text.split(']', 1)[1].split(' - ')[0].strip() if len(text.split(']', 1)) > 1 else text
                        fields['titre'] = titre_part
                    else:
                        fields['titre'] = text.split(' - ')[0].strip() if ' - ' in text else text
                    
                    # URL
                    fields['url'] = urljoin(self.base_url, link['href'])
                    
                    # Acheteur (deuxième partie)
                    if ' - ' in text:
                        parts = text.split(' - ')
                        if len(parts) > 1:
                            fields['acheteur'] = parts[1].strip()
                        else:
                            fields['acheteur'] = "Non spécifié"
                    else:
                        fields['acheteur'] = "Non spécifié"
                    
                    # Date de publication (fallback)
                    fields['date_publication'] = date_debut
                    
                    # Date limite (extrait en détail)
                    fields['date_limite'] = "N/A"
                    
                    # Traiter selon les catégories
                    if "informatique" in categories:
                        offre_it = self.traiter_offre_informatique(fields, extraction_complete)
                        if offre_it:
                            offres.append(offre_it)
                    
                    if "textile" in categories:
                        offre_textile = self.traiter_offre_textile(fields, extraction_complete)
                        if offre_textile:
                            offres.append(offre_textile)
                    
                    if "batiment" in categories:
                        offre_batiment = self.traiter_offre_batiment(fields, extraction_complete)
                        if offre_batiment:
                            offres.append(offre_batiment)
                    
                except Exception as e:
                    self.logger.error(f"❌ Erreur traitement annonce: {e}")
                    continue
            
            self.logger.info(f"📊 Résultats: {len([o for o in offres if o.secteur_activite == 'informatique'])} IT, "
                           f"{len([o for o in offres if o.secteur_activite == 'textile'])} Textile, "
                           f"{len([o for o in offres if o.secteur_activite == 'batiment'])} Bâtiment")
            
        except Exception as e:
            self.logger.error(f"❌ ERREUR SCRAPING: {e}\n{traceback.format_exc()}")
        
        return offres

    def get_offres_cache(self):
        """Retourner les offres en cache (pending)"""
        return [
            {
                "reference": offre.reference,
                "description": offre.description,
                "secteur_activite": offre.secteur_activite,
                "secteur_activite_id": offre.secteur_activite_id,
                "activities_ids": offre.activities_ids,
                "promoter": offre.promoter,
                "publicationDate": offre.publicationDate,
                "expirationDate": offre.expirationDate,
                "extractionDate": offre.extractionDate,
                "cahier_charge_pdf": offre.cahier_charge_pdf,
                "cahier_charge_pdf_filename": offre.cahier_charge_pdf_filename,
                "lots": offre.lots,
                "procedure": offre.procedure,
                "type_marche": offre.type_marche,
                "url_source": offre.url_source,
                "status": offre.status,
                "source": offre.source
            } for offre in self.offres_cache
        ]

    def get_secteurs_for_frontend(self):
        """Retourner les secteurs pour le frontend"""
        return [{"id": sid, "name": data["name"]} for sid, data in self.secteurs.items()]

    def update_offre_in_cache(self, reference: str, updated_data: dict) -> bool:
        """Mettre à jour une offre dans le cache et DB"""
        for i, offre in enumerate(self.offres_cache):
            if offre.reference == reference:
                for key, value in updated_data.items():
                    if hasattr(offre, key):
                        setattr(offre, key, value)
                
                if 'secteur_activite_id' in updated_data:
                    new_id = updated_data['secteur_activite_id']
                    if new_id in self.secteurs:
                        setattr(offre, 'secteur_activite', self.secteurs[new_id]['name'])
                
                # Mettre à jour en DB
                pending_tenders_collection.replace_one(
                    {"reference": reference, "source": "France Marchés"},
                    offre.to_dict()
                )
                self.logger.info(f"✅ Offre {reference} mise à jour")
                return True
        return False

    def get_tenders_from_db(self, limit=100):
        """Récupérer les tenders validés de la DB"""
        try:
            tenders = list(tenders_collection.find({
                "status": "active",
                "source": "France Marchés"
            }).limit(limit).sort("createdAt", -1))
            
            for tender in tenders:
                tender["_id"] = str(tender["_id"])
                tender["extractionDate"] = tender.get("extractionDate", "")
                tender["validationDate"] = tender.get("validationDate", "")
            
            return tenders
        except PyMongoError as e:
            self.logger.error(f"Erreur récupération DB: {e}")
            return []


